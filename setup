#!/data/data/com.termux/files/usr/bin/bash

echo "🚀 Atualizando Trepo..."
echo ""

echo "📁 Criando estrutura..."
mkdir -p dists/stable/main/binary-aarch64

echo "📦 Gerando Packages..."
dpkg-scanpackages packages /dev/null > dists/stable/main/binary-aarch64/Packages

echo "🗜️ Gerando Packages.xz..."
rm -f dists/stable/main/binary-aarch64/Packages.xz
xz -9 -k dists/stable/main/binary-aarch64/Packages

echo "📝 Gerando Release..."

cd dists/stable

apt-ftparchive release . > Release

cd ../..

echo ""
echo "✅ Release atualizado!"

echo "📊 Pacotes encontrados:"
grep -c '^Package:' dists/stable/main/binary-aarch64/Packages

echo ""
echo "📤 Enviando para o GitHub..."

git add .
git commit -m "Updated packages"
git push

echo ""
echo "🎉 Trepo atualizado com sucesso!"
